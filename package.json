{
  "name": "ipx",
  "version": "4.0.0-beta.1",
  "description": "High performance, secure and easy-to-use image optimizer.",
  "repository": "unjs/ipx",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.mjs"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "ipx": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "gen:operations": "node ./scripts/gen-operations.ts",
    "ipx": "node ./src/cli.ts",
    "lint": "eslint . && prettier -c src test scripts automd.config.ts",
    "lint:fix": "automd && eslint . --fix && prettier -w src test scripts automd.config.ts",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm build && changelogen --release --prerelease --push && npm publish --tag latest",
    "start": "node bin/ipx.js",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "srvx": "^0.12.4"
  },
  "devDependencies": {
    "@fastify/accept-negotiator": "^2.0.1",
    "@types/etag": "^1.8.4",
    "@types/is-valid-path": "^0.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "eslint-config-unjs": "^0.6.2",
    "etag": "^1.8.1",
    "h3": "2.0.1-rc.26",
    "image-meta": "^0.2.2",
    "obuild": "^0.4.38",
    "oxc-minify": ">=0.141.0",
    "prettier": "^3.9.6",
    "svgo": "^4.0.2",
    "typescript": "^6",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "unstorage": "*"
  },
  "peerDependenciesMeta": {
    "unstorage": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.16.0 || >=22.3.0"
  },
  "packageManager": "pnpm@11.17.0"
}
